{
  "name": "gema-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "Vassel Goleyu",
  "license": "MIT",
  "scripts": {
    "build:wasm": "wasm-pack build ../dsp --target web --release --out-dir ../web/src/wasm-pkg --out-name dsp_wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.10.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
